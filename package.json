{
  "name": "food-quality-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Food QC/QA entry-level portfolio with SQLite-backed experience search",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:static": "node static-server.js",
    "db:init": "node scripts/init-db.js",
    "test": "node --test test/database.test.js",
    "dev": "wrangler dev --env development",
    "deploy": "wrangler deploy --env \"\"",
    "d1:create": "wrangler d1 create portfolio-khj",
    "d1:migrate": "wrangler d1 migrations apply portfolio-khj --remote",
    "d1:seed:generate": "node scripts/seed-d1.js",
    "d1:seed": "wrangler d1 execute portfolio-khj --remote --file migrations/0002_seed_experiences.sql",
    "test:worker": "node --test test/qna.test.cjs"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
